// Q1: Callback flow
 
// Callback function: runs AFTER the greeting
function showEndMessage() {
  console.log("Welcome to the course!");
}
 
// Higher-order function: receives a function as an argument
function greetUser(name, callback) {
  console.log(`Hello ${name}`); // Step 1: greet
  callback();                   // Step 2: call the callback
}
 
console.log("Start");
greetUser("Aman", showEndMessage);
console.log("End");