// Q2: applyOperation with callbacks
 
// Applies the callback to every element and returns a new array
function applyOperation(numbers, operation) {
  const result = [];
  for (const num of numbers) {
    result.push(operation(num));
  }
  return result;
}
 
const nums = [1, 2, 3, 4];
 
const double = (n) => n * 2;
const square = (n) => n * n;
 
console.log("Doubled:", applyOperation(nums, double)); // [2, 4, 6, 8]
console.log("Squared:", applyOperation(nums, square)); // [1, 4, 9, 16]
 