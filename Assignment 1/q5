// Q5: Prototype inheritance (Person -> Student)

function Person(name) {
  this.name = name;
}
Person.prototype.printName = function () {
  console.log(`Name: ${this.name}`);
};

function Student(name, branch) {
  Person.call(this, name); // inherit Person's properties
  this.branch = branch;
}

// Link prototype chain: Student.prototype -> Person.prototype
Student.prototype = Object.create(Person.prototype);
Student.prototype.constructor = Student; // restore constructor reference

Student.prototype.printBranch = function () {
  console.log(`Branch: ${this.branch}`);
};

const s1 = new Student("Neha", "CSE");
s1.printName();   // found on Person.prototype
s1.printBranch(); // found on Student.prototype

console.log(s1 instanceof Student);                                   // true
console.log(s1 instanceof Person);                                    // true
console.log(Object.getPrototypeOf(s1) === Student.prototype);         // true
console.log(Object.getPrototypeOf(Student.prototype) === Person.prototype); // true