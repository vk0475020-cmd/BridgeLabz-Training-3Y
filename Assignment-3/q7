"use strict";
// Q7 - Smart Calculator

class InvalidOperationError extends Error {
  constructor(operation) {
    super(`Invalid operation: "${operation}"`);
    this.name = "InvalidOperationError";
  }
}

const operations = ["add", "divide", "power", "root", "subtract", "modulo"]; // modulo = unknown
const num1 = 25, num2 = 0;

function calculate(operation, a, b) {
  switch (operation) {
    case "add":
      return a + b;
    case "subtract":
      return a - b;
    case "divide":
      if (b === 0) throw new Error("Cannot divide by zero");
      return a / b;
    case "power":
      return a ** b;
    case "root":
      if (a < 0) throw new Error("Cannot take root of a negative number");
      return Math.sqrt(a);
    default:
      throw new InvalidOperationError(operation);
  }
}

console.log(`Inputs: num1=${num1}, num2=${num2}`);
console.log("---------- Summary ----------");
for (const op of operations) {
  try {
    console.log(`${op.padEnd(9)} = ${calculate(op, num1, num2)}`);
  } catch (error) {
    console.log(`${op.padEnd(9)} ERROR (${error.name}): ${error.message}`);
  }
}

// extra check for the negative root case
try {
  calculate("root", -9, 0);
} catch (error) {
  console.log("root of -9 ->", error.message);
}