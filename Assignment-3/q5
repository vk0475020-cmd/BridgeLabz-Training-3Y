"use strict";
// Q5 - Hoisting Lab

// ----- 1. Original code (predicted output: undefined, Game started, ready) -----
// Memory state before any line runs (creation phase):
//   score      -> var: hoisted, value = undefined
//   announce   -> function declaration: fully hoisted (name AND body)
//   status     -> let: hoisted but in the TEMPORAL DEAD ZONE until its line runs
//   startGame  -> function declaration: fully hoisted
console.log("--- original ---");
console.log(score);   // undefined (not an error)
announce();           // works: "Game started"
var score = 50;
function announce() { console.log("Game started"); }
let status = "ready";
startGame();          // fine, because `status` is already set by the time we CALL it
function startGame() { console.log(status); }

