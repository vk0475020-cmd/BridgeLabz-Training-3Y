// ----- 3. Arrow function version -----
// Arrow functions stored in const/let are NOT hoisted like declarations
// (the variable is in the TDZ until the line runs).
console.log("--- arrow functions ---");
try {
  announceArrow(); // ReferenceError: Cannot access before initialization
} catch (e) {
  console.log("Caught:", e.name, "-", e.message);
}
const announceArrow = () => console.log("Game started");
announceArrow(); // works now, because it's called AFTER the definition