// Q3 - Math Utility Dashboard

const x = 16.75;

const rounded = Math.round(x);
const squareRoot = Math.sqrt(x);
const cube = Math.pow(x, 3);
// random whole number from 10 to 50: random()*41 gives 0-40, +10 shifts it to 10-50
const randomNumber = Math.floor(Math.random() * 41) + 10;

console.log(`
===== Math Dashboard =====
Number        : ${x}
Rounded       : ${rounded}
Square root   : ${squareRoot.toFixed(3)}
Power (x^3)   : ${cube.toFixed(2)}
Random (10-50): ${randomNumber}
==========================`);