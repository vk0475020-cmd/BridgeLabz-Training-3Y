// Q7 - Customer Feedback Processor

const feedback = "Great product! Fast delivery and amazing sound quality!";

// split on spaces to count words (filter removes empty pieces if there are extra spaces)
const words = feedback.trim().split(" ").filter((word) => word !== "");
console.log(`Word count: ${words.length}`);

// lowercase first so "Poor" and "BAD" are also caught
const lowerFeedback = feedback.toLowerCase();
const hasNegativeWords = lowerFeedback.includes("bad") || lowerFeedback.includes("poor");

if (!hasNegativeWords) {
  console.log("Positive Feedback");
} else {
  console.log("Needs Improvement");
}

// quick test with a negative review
const badFeedback = "Poor packaging and bad service";
console.log(`\n"${badFeedback}" ->`,
  badFeedback.toLowerCase().includes("bad") || badFeedback.toLowerCase().includes("poor")
    ? "Needs Improvement" : "Positive Feedback");