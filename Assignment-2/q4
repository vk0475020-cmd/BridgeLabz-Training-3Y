// Q4 - Array Performance Analyzer

// 8 random scores between 30 and 100 (inclusive)
const scores = Array.from({ length: 8 }, () => Math.floor(Math.random() * 71) + 30);

const highest = Math.max(...scores);
const lowest = Math.min(...scores);

// reduce adds all the scores into one total
const total = scores.reduce((sum, score) => sum + score, 0);
const average = total / scores.length;

// filter keeps only passing scores (50 or more)
const passed = scores.filter((score) => score >= 50);

// map builds a readable list with pass/fail labels
const labelled = scores.map((score, i) => `Student ${i + 1}: ${score} (${score >= 50 ? "Pass" : "Fail"})`);

console.log("Scores:", scores.join(", "));
labelled.forEach((line) => console.log(line));
console.log("\n----- Summary -----");
console.log(`Highest : ${highest}`);
console.log(`Lowest  : ${lowest}`);
console.log(`Average : ${average.toFixed(2)}`);
console.log(`Passed  : ${passed.length} out of ${scores.length}`);
