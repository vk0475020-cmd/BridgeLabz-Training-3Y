// Q2 - student form validation with RegExp

const rules = {
  name:     { regex: /^[A-Za-z]+( [A-Za-z]+)*$/, message: "Name can contain only alphabets." },
  email:    { regex: /^[^\s@]+@[^\s@]+\.[^\s@]+$/, message: "Enter a valid email (example@domain.com)." },
  phone:    { regex: /^\d{10}$/, message: "Phone must be exactly 10 digits." },
  // lookaheads: at least one uppercase, one digit and one special character
  password: { regex: /^(?=.*[A-Z])(?=.*\d)(?=.*[^A-Za-z0-9]).+$/, message: "Password needs 1 uppercase, 1 number and 1 special character." },
};

function validateField(id) {
  const input = document.getElementById(id);
  const errorBox = input.nextElementSibling;
  const ok = rules[id].regex.test(input.value.trim());

  input.classList.toggle("valid", ok);   // green border
  input.classList.toggle("invalid", !ok); // red border
  errorBox.textContent = ok ? "" : rules[id].message;
  return ok;
}

// validate while typing
Object.keys(rules).forEach((id) => {
  document.getElementById(id).addEventListener("input", () => validateField(id));
});

document.getElementById("studentForm").addEventListener("submit", (e) => {
  e.preventDefault();
  const allValid = Object.keys(rules).map(validateField).every(Boolean);
  document.getElementById("result").textContent = allValid ? "Registration successful!" : "";
});