// Q6 - employee management

class Employee {
  constructor(id, name, department, salary) {
    this.id = id;
    this.name = name;
    this.department = department;
    this.salary = salary; // monthly salary
  }

  getAnnualSalary() {
    return this.salary * 12;
  }

  // increases the monthly salary by the given percent
  applyBonus(percent) {
    this.salary += (this.salary * percent) / 100;
  }
}

const employees = [
  new Employee(1, "Amit", "Engineering", 60000),
  new Employee(2, "Neha", "HR", 45000),
  new Employee(3, "Ravi", "Sales", 40000),
  new Employee(4, "Pooja", "Engineering", 70000),
  new Employee(5, "Suresh", "Finance", 50000),
];

employees[0].applyBonus(10); // Amit gets a 10% bonus

employees.forEach((emp) => {
  console.log(`${emp.name} (${emp.department}) - Annual: Rs.${emp.getAnnualSalary()}`);
});

// reduce adds all annual salaries into one number
const totalPayout = employees.reduce((total, emp) => total + emp.getAnnualSalary(), 0);
console.log(`\nTotal annual payout: Rs.${totalPayout}`);