// Q8 - update an object from a form
const user = { name: "John", email: "john@mail.com", age: 21 };

const nameInput = document.getElementById("name");
const emailInput = document.getElementById("email");
const ageInput = document.getElementById("age");
const display = document.getElementById("display");

function showUser() {
  display.textContent = JSON.stringify(user, null, 2);
}

// fill form with the starting values
nameInput.value = user.name;
emailInput.value = user.email;
ageInput.value = user.age;
showUser();

// updates the object and the display from the form
function updateUser() {
  user.name = nameInput.value;
  user.email = emailInput.value;
  user.age = Number(ageInput.value);
  showUser();
}

// "real time" = update on every keystroke; submit also works
[nameInput, emailInput, ageInput].forEach((el) => el.addEventListener("input", updateUser));
document.getElementById("userForm").addEventListener("submit", (e) => {
  e.preventDefault();
  updateUser();
});