// Q1 – Async Coffee Maker (Promise chaining)

// Returns a random delay between 1000 and 2000 ms
const randomDelay = () => 1000 + Math.random() * 1000;

// Generic step helper: logs, waits, then resolves (or rejects ~20% of the time)
function step(message, doneMessage) {
  return new Promise((resolve, reject) => {
    console.log(message);
    setTimeout(() => {
      if (Math.random() < 0.2) {
        reject(new Error(`Failed while: ${message}`)); // simulated random failure
      } else {
        console.log(doneMessage);
        resolve();
      }
    }, randomDelay());
  });
}

const boilWater = () => step("Boiling water...", "Water is boiled.");
const brewCoffee = () => step("Brewing coffee...", "Coffee is brewed.");
const pourIntoCup = () => step("Pouring into cup...", "Coffee poured into cup.");

// Chain the steps; each .then() starts only after the previous Promise resolves
boilWater()
  .then(brewCoffee)
  .then(pourIntoCup)
  .then(() => console.log("Coffee ready for the team!"))
  .catch((err) => console.error("Coffee process failed:", err.message)); // any rejection lands here