// Q10 – Async Delivery Pipeline

// Creates a step: waits 1–2s, then succeeds or fails (~10% failure)
function createStep(logMessage, errorMessage) {
  return () =>
    new Promise((resolve, reject) => {
      const delay = 1000 + Math.random() * 1000;
      setTimeout(() => {
        if (Math.random() < 0.1) reject(new Error(errorMessage));
        else {
          console.log(logMessage);
          resolve();
        }
      }, delay);
    });
}

const takeOrder = createStep("Step 1: Order taken", "Order failed");
const prepare = createStep("Step 2: Food prepared", "Preparation failed");
const pack = createStep("Step 3: Package ready", "Packing failed");
const dispatch = createStep("Step 4: Out for delivery", "Dispatch failed");
const deliver = createStep("Delivery completed!", "Delivery failed");

async function runPipeline() {
  console.log("Start Pipeline");
  try {
    // Each await pauses THIS function only; the call stack is freed so the
    // event loop can run other tasks. When the timer fires (macrotask), the
    // promise resolves and the continuation is queued as a microtask.
    await takeOrder();
    await prepare();
    await pack();
    await dispatch();
    await deliver();
  } catch (err) {
    // A rejected promise throws at the awaiting line and jumps here
    console.log("Pipeline failed!");
    console.error(err.message);
  }
}

runPipeline();
console.log("(runPipeline called – code after it runs while the pipeline waits)");